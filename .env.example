# Copy this file to `.env` and adjust values for your environment.
# Never commit the actual `.env` file.

# --- Database ---
# When running via docker-compose, `db` is the service name of the Postgres
# container (see docker-compose.yml), so this URL works out of the box.
DATABASE_URL=postgresql://postgres:postgres@db:5432/eve_healthcare

# --- Auth / JWT ---
# Generate a real secret for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Misc ---
ENVIRONMENT=development
LOG_LEVEL=INFO
